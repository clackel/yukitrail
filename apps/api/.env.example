# Reference only: Spring Boot does not load this file automatically.
# Copy the values you need into the terminal or IDE run configuration.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yukitrail
DB_USERNAME=yukitrail
DB_PASSWORD=yukitrail-local
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_ISSUER=https://api.yukitrail.local
JWT_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_COOKIE_SECURE=false

# Local development can use ephemeral keys. Deployment must set this to true
# and provide Base64-encoded PKCS#8 private and X.509 public DER keys.
JWT_KEYS_REQUIRED=false
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
